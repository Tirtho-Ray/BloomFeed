model User {
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    password      String
    emailVerified DateTime?
    role          UserRole
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
}

enum UserRole {
    USER
    SUPPORTER
    ADMIN
    SUPER_ADMIN
}
